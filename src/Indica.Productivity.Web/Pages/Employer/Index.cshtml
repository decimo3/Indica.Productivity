@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<EmployerResources> GlobalLocalizer
@inject IViewLocalizer LocalLocalizer

@model IndexModel
@{
    ViewData["Title"] = @LocalLocalizer["Title"];
}

<a asp-page="./Create">@LocalLocalizer["NewEmployer"]</a>
<br/>
@if (Model.Employers.Any())
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th scope="col">@GlobalLocalizer["MainID"]:</th>
                <th scope="col">@GlobalLocalizer["ClientID"]:</th>
                <th scope="col">@GlobalLocalizer["FullName"]:</th>
                <th scope="col">@GlobalLocalizer["Admission"]:</th>
                <th scope="col">@GlobalLocalizer["Demission"]:</th>
                <th scope="col">@GlobalLocalizer["Situation"]:</th>
                <th scope="col">@GlobalLocalizer["Function"]:</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employer in Model.Employers)
            {
                <tr scope="row">
                    <td>@employer.IndicaRegistry</td>
                    <td>@employer.ClientRegistry</td>
                    <td>@employer.FullName</td>
                    <td>@employer.Admission</td>
                    <td>@employer.Demission</td>
                    <td>@employer.IdSituation</td>
                    <td>@employer.IdFunction</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>@LocalLocalizer["EmptyEmployers"].</p>
}