@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> SharedLocalizer
@inject IStringLocalizer<EmployerResources> GlobalLocalizer
@inject IViewLocalizer LocalLocalizer

@model IndexModel
@{
    ViewData["Title"] = @LocalLocalizer["Title"];
    ViewData["ModalTitle"] = Model.Error?.GetType().Name;
    ViewData["ModalMessage"] = Model.Error?.Message;
}
<div class="row">
    <div class="col-6 text-start">
        <a asp-page="./Upsert">@LocalLocalizer["NewEmployer"]</a>
    </div>
    <div class="col-6 text-end">
        <a asp-page="./Import">@LocalLocalizer["ImportEmployers"]</a>
    </div>
</div>

<br/>

@if (Model.Employers.Any())
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th class="col-1">@GlobalLocalizer["MainID"]:</th>
                <th class="col-1">@GlobalLocalizer["ClientID"]:</th>
                <th class="col-5">@GlobalLocalizer["FullName"]:</th>
                <th class="col-1">@GlobalLocalizer["Admission"]:</th>
                <th class="col-1">@GlobalLocalizer["Demission"]:</th>
                <th class="col-1">@GlobalLocalizer["Situation"]:</th>
                <th class="col-1">@GlobalLocalizer["Function"]:</th>
                <th class="col-1">@SharedLocalizer["Options"]:</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employer in Model.Employers)
            {
                <tr scope="row">
                    <td>@employer.IndicaRegistry</td>
                    <td>@employer.ClientRegistry</td>
                    <td>@employer.FullName</td>
                    <td>@employer.Admission</td>
                    <td>@employer.Demission</td>
                    <td>@employer.IdSituation</td>
                    <td>@employer.IdFunction</td>
                    <td>
                        @if (employer.Demission is null)
                        {
                            <div class="d-flex">
                                <a asp-page="./Upsert" asp-route-id="@employer.Id">@SharedLocalizer["Edit"]</a> /
                                <form method="post" asp-page-handler="Delete" asp-route-id="@employer.Id">
                                    <button type="submit" class="btn btn-link p-0 border-0 align-baseline text-danger">@SharedLocalizer["Delete"]</button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-center">@LocalLocalizer["EmptyEmployers"].</p>
}
